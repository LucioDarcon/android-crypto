<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="viewModel"
            type="com.ldss.binary.protector.viewmodels.CryptoViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        tools:context=".activities.CryptoActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:text="@string/title_crypto"
                android:textAppearance="?attr/textAppearanceHeadlineMedium" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAlias"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/hint_device_alias">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAlias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@={viewModel.aliasInput}" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPlainText"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/hint_plain_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPlainText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@={viewModel.plainTextInput}" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEncrypt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:onClick="@{() -> viewModel.onEncryptClicked()}"
                android:text="@string/btn_encrypt" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_encrypted_result"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:visibility="@{viewModel.encryptedResult.empty ? View.GONE : View.VISIBLE}" />

            <TextView
                android:id="@+id/tvEncrypted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="?attr/colorSurfaceVariant"
                android:padding="8dp"
                android:text="@{viewModel.encryptedResult}"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:visibility="@{viewModel.encryptedResult.empty ? View.GONE : View.VISIBLE}"
                tools:text="e29iamRzYW5k..." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDecrypt"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:onClick="@{() -> viewModel.onDecryptClicked()}"
                android:visibility="@{viewModel.encryptedResult.empty ? View.GONE : View.VISIBLE}"
                android:text="@string/btn_decrypt" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_decrypted_result"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:visibility="@{viewModel.decryptedResult.empty ? View.GONE : View.VISIBLE}" />

            <TextView
                android:id="@+id/tvDecrypted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="?attr/colorSurfaceVariant"
                android:padding="8dp"
                android:text="@{viewModel.decryptedResult}"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorPrimary"
                android:visibility="@{viewModel.decryptedResult.empty ? View.GONE : View.VISIBLE}"
                tools:text="Texto original decriptografado" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_logs"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp">

                <TextView
                    android:id="@+id/tvLogs"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:text="@{viewModel.logs}"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    tools:text="Logs de criptografia..." />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
